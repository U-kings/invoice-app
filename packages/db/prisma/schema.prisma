generator client {
  provider               = "prisma-client"
  output                 = "../src/generated"
  generatedFileExtension = "ts"
  importFileExtension    = ""
  moduleFormat           = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                      @id @default(uuid())
  firstName                  String
  middleName                 String?
  lastName                   String
  class                      String?
  email                      String                      @unique
  phoneNumber                String?
  password                   String?
  googleId                   String?                     @unique
  role                       String?                     @default("USER")
  terms                      Boolean                     @default(false)
  isVerified                 Boolean                     @default(false)
  verificationToken          String?
  verificationTokenExpires   DateTime?
  resetToken                 String?                     @unique
  resetTokenExpires          DateTime?
  profileImageUrl            String?
  profileImagePublicId       String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  businessProfile            BusinessProfile?
  customers                  Customer[]
  invoices                   Invoice[]
  invoiceReminderSettings    InvoiceReminderSettings?
  invoiceSettings            InvoiceSettings?
  invoiceReminders           InvoiceReminder[]
  paymentSettings            PaymentSettings?
  paymentProviderConnections PaymentProviderConnection[]
  products                   Product[]
}

model BusinessProfile {
  id     String @id @default(uuid())
  userId String @unique

  businessName String
  countryCode  String
  currency     String

  email   String?
  phone   String?
  website String?

  address    String?
  city       String?
  state      String?
  postalCode String?

  taxId        String?
  logoUrl      String?
  logoPublicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id          String         @id @default(uuid())
  userId      String
  name        String
  email       String
  phone       String?
  address     String?
  status      CustomerStatus @default(ACTIVE)
  countryCode String?
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices    Invoice[]
}

model Invoice {
  id               String            @id @default(uuid())
  invoiceNumber    String
  userId           String
  customerId       String
  status           InvoiceStatus     @default(DRAFT)
  currency         String
  issueDate        DateTime
  dueDate          DateTime
  paymentTerm      String?
  discount         Decimal           @default(0) @db.Decimal(10, 2)
  taxRate          Decimal           @default(0) @db.Decimal(5, 2)
  notes            String?
  sentAt           DateTime?
  paidAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  publicToken      String            @unique @default(uuid())
  cancelledAt      DateTime?
  customer         Customer          @relation(fields: [customerId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lineItems        LineItem[]
  payments         Payment[]
  invoiceReminders InvoiceReminder[]

  @@unique([userId, invoiceNumber])
}

model Product {
  id     String @id @default(uuid())
  userId String

  name        String
  description String?
  rate        Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int
  rate        Decimal @db.Decimal(10, 2)
  name        String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoiceSettings {
  id String @id @default(uuid())

  userId String @unique

  // Numbering
  invoiceNumberPrefix String @default("INV-")
  nextInvoiceNumber   Int    @default(1)

  // Defaults
  defaultCurrency    String  @default("NGN")
  defaultPaymentTerm String  @default("Due-on-receipt")
  defaultTaxRate     Decimal @default(0) @db.Decimal(5, 2)
  defaultDiscount    Decimal @default(0) @db.Decimal(5, 2)

  // Content
  defaultNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InvoiceReminderSettings {
  id String @id @default(uuid())

  userId String @unique

  enabled Boolean @default(true)

  beforeDueEnabled Boolean @default(true)
  beforeDueDays    Int     @default(3)

  dueDateEnabled Boolean @default(true)

  overdueEnabled      Boolean @default(true)
  overdueAfterDays    Int     @default(1)
  overdueRepeatDays   Int     @default(7)
  maxOverdueReminders Int     @default(3)

  emailSubject String?
  emailMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InvoiceReminder {
  id String @id @default(uuid())

  invoiceId String
  userId    String

  type         InvoiceReminderType
  scheduledFor DateTime

  attempts  Int     @default(0)
  lastError String?

  processingAt DateTime?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([scheduledFor, sentAt])
  @@index([invoiceId])
  @@index([userId])
}

enum InvoiceReminderType {
  BEFORE_DUE
  DUE_DATE
  OVERDUE
}

model PaymentSettings {
  id     String @id @default(uuid())
  userId String @unique

  // Online payment providers
  paystackEnabled Boolean @default(false)
  stripeEnabled   Boolean @default(false)
  paypalEnabled   Boolean @default(false)

  // Payment methods
  cardPayments Boolean @default(true)
  bankTransfer Boolean @default(true)
  cashPayments Boolean @default(false)

  // Payment behavior
  onlinePayments               Boolean @default(true)
  paymentLinks                 Boolean @default(true)
  partialPayments              Boolean @default(false)
  automaticPaymentConfirmation Boolean @default(true)

  // Bank transfer information
  bankName              String?
  accountName           String?
  accountNumber         String?
  additionalInformation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PaymentConnectionStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  ERROR
}

model PaymentProviderConnection {
  id       String                  @id @default(uuid())
  userId   String
  provider PaymentProvider
  status   PaymentConnectionStatus @default(PENDING)

  providerAccountId  String?
  providerMerchantId String?

  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?

  encryptedSecretKey String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider])
  @@index([providerAccountId])
  @@index([providerMerchantId])
}

model Payment {
  id String @id @default(uuid())

  invoiceId String

  provider              PaymentProvider
  providerTransactionId String?
  providerReference     String?

  amount   Decimal @db.Decimal(12, 2)
  currency String

  status PaymentStatus @default(PENDING)

  checkoutUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([providerTransactionId])
  @@index([providerReference])
}

model PaymentProviderConfig {
  id String @id @default(uuid())

  provider    PaymentProvider
  countryCode String
  currency    String

  enabled  Boolean @default(true)
  priority Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode, currency])
}

enum PaymentProvider {
  PAYSTACK
  STRIPE
  FLUTTERWAVE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
  BLOCKED
}
