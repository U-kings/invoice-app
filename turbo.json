{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "MONGO_URI",
    "JWT_SECRET",
    "NODE_ENV",
    "PAYSTACK_SECRET",
    "NEXT_PUBLIC_BASE_URL",
    "NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY",
    "PAYSTACK_SECRET_KEY",
    "RESEND_API_KEY",
    "NEXT_PUBLIC_APP_URL",
    "DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["APP_*"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "cache": true
    },
    "db:push": {
      "env": ["DATABASE_URL"],
      "cache": false
    }
  }
}
